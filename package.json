{
  "name": "debt-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run api\" \"npm run web\"",
    "web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "vercel-build": "vite build",
    "api": "node --import tsx api/dev.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.0",
    "@astryxdesign/theme-neutral": "^0.1.0",
    "@electric-sql/pglite": "^0.5.4",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
